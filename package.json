{
  "name": "duck-hermes-studio",
  "version": "0.1.0",
  "description": "Editor minimalista com agente de IA integrado",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/self-test.js",
    "start:app": "node scripts/packaged.js",
    "build": "node scripts/build-app.js",
    "build:linux": "node scripts/build-app.js linux-x64",
    "build:win": "node scripts/build-app.js win-x64",
    "build:mac": "node scripts/build-app.js macos-x64 macos-arm64",
    "mcp": "node scripts/mcp-server.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "bin": {
    "duck-hermes-studio": "scripts/packaged.js"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "services/**/*.js",
      "scripts/packaged.js"
    ],
    "assets": [
      "public/**/*",
      "config/**/*",
      "package.json"
    ],
    "outputPath": "dist"
  }
}
